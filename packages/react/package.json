{
  "name": "@shipgraph/react",
  "version": "0.5.0",
  "description": "React binding for shipgraph — an idiomatic, SSR-safe <ShipGraph> component + useShipGraph hook over @shipgraph/core. Public props/callbacks are engine-agnostic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "vite build",
    "build": "pnpm run typecheck && pnpm run bundle",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@shipgraph/core": "workspace:^",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@shipgraph/core": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ship-With-AI/shipgraph.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Ship-With-AI/shipgraph#readme",
  "bugs": {
    "url": "https://github.com/Ship-With-AI/shipgraph/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
