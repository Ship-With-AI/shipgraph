{
  "name": "@shipgraph/core",
  "version": "0.4.0",
  "description": "Framework-agnostic graph visualization core — engine seam + data adapter + NVL-grade feel primitives, wrapping force-graph (Canvas 2D + d3-force) behind a shipgraph-owned API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "tsup",
    "build": "pnpm run typecheck && pnpm run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "perf": "node demo/perf.mjs"
  },
  "dependencies": {
    "force-graph": "^1.49.5"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "puppeteer": "^23.11.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ship-With-AI/shipgraph.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ship-With-AI/shipgraph#readme",
  "bugs": {
    "url": "https://github.com/Ship-With-AI/shipgraph/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
