{
  "name": "@shipgraph/vue",
  "version": "0.1.0",
  "description": "Vue 3 binding for shipgraph — a reactive, SSR/Nuxt-safe <ShipGraph> component over @shipgraph/core. Public props/emits are engine-agnostic.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "bundle": "vite build",
    "build": "npm run typecheck && npm run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "perf": "node demo/perf.mjs"
  },
  "peerDependencies": {
    "@shipgraph/core": "^0.1.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@shipgraph/core": "*",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "puppeteer": "^23.11.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ship-With-AI/shipgraph.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Ship-With-AI/shipgraph/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/Ship-With-AI/shipgraph/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
