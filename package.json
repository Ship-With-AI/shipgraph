{
  "name": "shipgraph-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "shipgraph — framework-agnostic, MIT graph visualization component. Monorepo root.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "docs:dev": "turbo run dev --filter=@shipgraph/docs",
    "docs:build": "turbo run build --filter=@shipgraph/docs",
    "docs:preview": "pnpm --filter @shipgraph/docs preview"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  }
}
